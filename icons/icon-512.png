<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0d6efd"/>
      <stop offset="100%" stop-color="#1e4d8c"/>
    </linearGradient>
    <linearGradient id="eyeGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#d6e4ff"/>
    </linearGradient>
    <radialGradient id="irisGrad" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#20c997"/>
      <stop offset="60%" stop-color="#0e8a68"/>
      <stop offset="100%" stop-color="#075c46"/>
    </radialGradient>
    <radialGradient id="pupilGrad" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#0b1220"/>
      <stop offset="100%" stop-color="#000000"/>
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.35"/>
    </filter>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b"/>
      <feMerge>
        <feMergeNode in="b"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Arka plan -->
  <rect width="512" height="512" rx="96" fill="url(#bg)"/>

  <!-- Hafif iç çerçeve -->
  <rect x="24" y="24" width="464" height="464" rx="72"
        fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="3"/>

  <!-- Göz dış hatları -->
  <g filter="url(#shadow)">
    <path d="M 96 256
             C 96 180, 180 120, 256 120
             C 332 120, 416 180, 416 256
             C 416 332, 332 392, 256 392
             C 180 392, 96 332, 96 256 Z"
          fill="url(#eyeGrad)"/>
  </g>

  <!-- İris -->
  <circle cx="256" cy="256" r="92" fill="url(#irisGrad)"/>
  <!-- İris halkası -->
  <circle cx="256" cy="256" r="92" fill="none"
          stroke="#0b1220" stroke-opacity="0.35" stroke-width="4"/>
  <!-- İris detay çizgileri -->
  <g stroke="#0b1220" stroke-opacity="0.18" stroke-width="2">
    <line x1="256" y1="164" x2="256" y2="200"/>
    <line x1="256" y1="312" x2="256" y2="348"/>
    <line x1="164" y1="256" x2="200" y2="256"/>
    <line x1="312" y1="256" x2="348" y2="256"/>
    <line x1="191" y1="191" x2="216" y2="216"/>
    <line x1="296" y1="296" x2="321" y2="321"/>
    <line x1="321" y1="191" x2="296" y2="216"/>
    <line x1="216" y1="296" x2="191" y2="321"/>
  </g>

  <!-- Göz bebeği -->
  <circle cx="256" cy="256" r="42" fill="url(#pupilGrad)"/>

  <!-- Işık parlaması -->
  <circle cx="278" cy="234" r="14" fill="#ffffff" opacity="0.85" filter="url(#glow)"/>
  <circle cx="240" cy="276" r="6" fill="#ffffff" opacity="0.5"/>

  <!-- Harf: "E" (görme testi sembolü) -->
  <g filter="url(#shadow)" opacity="0.95">
    <rect x="380" y="380" width="96" height="96" rx="22" fill="#ffd84d"/>
    <text x="428" y="460"
          font-family="'Courier New', monospace"
          font-size="72" font-weight="900"
          fill="#0b1220" text-anchor="middle">E</text>
  </g>

  <!-- Küçük dekoratif harf -->
  <text x="120" y="440"
        font-family="'Courier New', monospace"
        font-size="44" font-weight="900"
        fill="#ffffff" opacity="0.15"
        text-anchor="middle">A</text>
</svg>